@{
    ViewData["Title"] = "Home Page";
}



<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    
    

    <!--Utiliser ce div pour afficher la 1ere vue partielle-->

    <div id="zone-part">

    </div>
    <input type="text" id="texte" placeholder="Exemple" />
    <input type="number" id="qty" value="3" />

    <button id="btn-ajax" type="button">Ajax avec data</button>


       <!--Utiliser ce div pour afficher la 2e vue partielle-->
    <div id="part2">

    </div>

</div>
@section Scripts{
    <script>
        // TODO: Écrire votre script
        $.get('@Url.Action("Partielle", "Home")', function(x){
            $('#zone-part').html(x);
        });

        $("#btn-ajax").on("click", function(){
            let data = {
                qty: $("#qty").val(),
                Texte: $("#texte").val()
            }
            
            console.log(data)

            $.get('@Url.Action("Partielle2", "Home")', data, function(resultat) {

                console.log(resultat);
                $("#part2").html(resultat);

            })
        })

    </script>
}